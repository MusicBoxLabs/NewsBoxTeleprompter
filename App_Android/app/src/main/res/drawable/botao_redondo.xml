<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E63A3400" />
            <stroke android:width="2dp" android:color="@color/ambar" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E61A1800" />
            <stroke android:width="1dp" android:color="@color/borda_forte" />
        </shape>
    </item>
</selector>
