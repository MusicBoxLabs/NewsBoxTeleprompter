<?xml version="1.0" encoding="utf-8"?>
<!-- Os tres tamanhos de letra. O escolhido fica com a borda dobrada
     e acesa; os outros dois recuam. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#F22A2600" />
            <stroke android:width="2dp" android:color="@color/ambar" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/caixa" />
            <stroke android:width="1dp" android:color="@color/borda" />
        </shape>
    </item>
</selector>
