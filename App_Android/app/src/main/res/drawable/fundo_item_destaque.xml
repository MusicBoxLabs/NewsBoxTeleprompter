<?xml version="1.0" encoding="utf-8"?>
<!-- O primeiro item do menu, e o primeiro texto da lista, vem
     acesos: numa tela com camera atras, sem um ponto de partida
     iluminado o olho nao sabe onde pousar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E63A3400" />
            <stroke android:width="1dp" android:color="@color/ambar" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/caixa_ativa" />
            <stroke android:width="1dp" android:color="@color/ambar" />
        </shape>
    </item>
</selector>
