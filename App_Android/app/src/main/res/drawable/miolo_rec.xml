<?xml version="1.0" encoding="utf-8"?>
<!-- Circulo quando parado, quadrado quando gravando: a mesma gramatica
     de qualquer camera. Ninguem precisa aprender nada. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vermelho_rec" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ambar_fraco" />
        </shape>
    </item>
</selector>
